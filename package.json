{
  "name": "justsolo-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": ["apps/*", "packages/*"],
  "resolutions": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@trpc/server": "11.18.0"
  },
  "scripts": {
    "dev": "yarn workspace @justsolo/web dev",
    "build": "yarn workspace @justsolo/web build",
    "start": "yarn workspace @justsolo/web start",
    "lint": "yarn workspace @justsolo/web lint",
    "test": "yarn workspace @justsolo/web test && yarn workspace @justsolo/shared test",
    "typecheck": "yarn workspace @justsolo/web typecheck && yarn workspace @justsolo/shared typecheck && yarn workspace @justsolo/mobile typecheck",
    "db:migrate": "yarn workspace @justsolo/shared db:migrate",
    "db:studio": "yarn workspace @justsolo/shared db:studio",
    "import:restaurants": "yarn workspace @justsolo/shared import:restaurants",
    "mobile": "yarn workspace @justsolo/mobile start"
  }
}
