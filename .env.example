# 複製這個檔案為 .env 並依本機環境調整
# 本機開發：先 `createdb justsolo_db`，本機 Postgres 若用 trust/peer 驗證則不需密碼
DATABASE_URL="postgresql://USER@localhost:5432/justsolo_db?schema=public"

# Google Places API (New) 的 API Key，用於 scripts/import-restaurants.ts 匯入餐廳資料
GOOGLE_PLACE_NEW_API_KEY=

# Auth.js（帳號登入用，Google OAuth）。到 Google Cloud Console 申請 OAuth Client
# （Web application 類型），Authorized redirect URI 設為
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js 簽章用的密鑰，可用 `npx auth secret` 或 `openssl rand -base64 32` 產生
AUTH_SECRET=

# 手機版 Google 登入（@react-native-google-signin/google-signin）。
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID 直接複製上面 GOOGLE_CLIENT_ID 的值即可，
# 不用另外申請——原生 SDK 搭配這個 Web Client ID 設定後，簽出來的 id_token
# 的 audience 就是它，讓後端沿用同一組 GOOGLE_CLIENT_ID 驗證。
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID 是另外在 Google Cloud Console 新申請的
# iOS 類型 OAuth Client（Bundle ID: com.justsolo.app），申請後還要把它的
# 反向網域格式（com.googleusercontent.apps.xxx）填進 apps/mobile/app.json
# 的 iosUrlScheme。Android 不用在這裡填 Client ID，改成在 Console 註冊
# package name（com.justsolo.app）+ SHA-1 指紋。
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
