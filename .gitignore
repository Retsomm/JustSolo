# dependencies
/node_modules
/apps/*/node_modules
/packages/*/node_modules

# 這個 monorepo 一律用 yarn（見 package.json 的 packageManager），npx 有時會在 repo
# 根目錄意外產生 npm 的 lockfile，不要讓它被誤 commit。
/package-lock.json
/apps/*/package-lock.json
/packages/*/package-lock.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
